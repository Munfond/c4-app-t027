# Copy to root .env; never commit secrets or machine-specific paths.
# MVP web reads precomputed artifacts. No LLM/database key is required.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Defaults are absolute paths under the repo. Uncomment external overrides.
# NUSC_ROOT=C:/apps/nuscenes
# LAB_DATA_ROOT=C:/apps/lab
# SIM_DATA_ROOT=C:/apps/sim
# CAMERA_CACHE_DIR=C:/apps/lab/cache/cameras
# PLATE_WEIGHTS=C:/apps/weights/plate_yolov8.pt
ANONYMIZER_ENABLED=false
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=12000000

# SQLite default / PostgreSQL override for the main branch database adapters.
DATABASE_URL=sqlite:///./data/app.db

# Occupancy replay agent; see docs/REPLAY_SENSOR_AGENT.vi.md.
# Lab / Compare / Benchmarks and deterministic replay CLI do not need a key.
OPENAI_API_KEY=
# Select provider explicitly; keys are never interchangeable or sent to both hosts.
LLM_PROVIDER=openai
OPENROUTER_API_KEY=
# For OpenRouter use a catalog slug, e.g. openai/gpt-4o-mini.
EXPERIMENT_AGENT_ENABLED=false
EXPERIMENT_AGENT_MODEL=gpt-4o-mini
EXPERIMENT_DEVICE=cpu
EXPERIMENT_CPU_THREADS=2
# Recorded-data replay needs raw nuScenes-mini in NUSC_ROOT. Camera detector is optional.
# REPLAY_CAMERA_ONNX=D:/models/driving_detector_postnms.onnx
REPLAY_CAMERA_INPUT_SIZE=640
REPLAY_CAMERA_SCORE_THRESHOLD=0.25
EXPERIMENT_MAX_PENDING=5
EXPERIMENT_API_ENABLED_IN_PRODUCTION=false
# Remote CARLA backend only; leave local for the GPU worker and existing playback.
EXPERIMENT_EXECUTION_MODE=local
# Shared operator access code (>=32 chars); entered in the bot, never an LLM key.
EXPERIMENT_ACCESS_TOKEN=
# JSON mapping of worker IDs to different >=32-char tokens. Backend secret only.
REMOTE_WORKER_TOKENS={}
# PostgreSQL queue URL; explicit schema init: python -m scripts.init_remote_worker
REMOTE_DATABASE_URL=
REMOTE_STORAGE_ENDPOINT=
REMOTE_STORAGE_REGION=auto
REMOTE_STORAGE_BUCKET=
REMOTE_STORAGE_ACCESS_KEY=
REMOTE_STORAGE_SECRET_KEY=
REMOTE_STORAGE_PREFIX=p027-jobs
REMOTE_LEASE_SECONDS=120
REMOTE_ARTIFACT_MAX_BYTES=33554432
REMOTE_JOB_MAX_BYTES=536870912
# EXPERIMENT_ROOT=C:/apps/experiments
CARLA_HOST=127.0.0.1
CARLA_PORT=2000
CARLA_TM_PORT=8001
# Legacy 0.9.11 on low-end GPUs loads maps slowly; 120 (the maximum) avoids spurious timeouts.
CARLA_TIMEOUT_SECONDS=120
# Linux: worker starts/stops a fresh server per capture. Leave unset for an external server.
# CARLA_SERVER_EXECUTABLE=/absolute/path/carla-0.9.16/CarlaUE4/Binaries/Linux/CarlaUE4-Linux-Shipping
# Isolate CARLA 0.9.11's Python 3.7 client from the Python >=3.11 worker.
# CARLA_PYTHON_EXECUTABLE=<CARLA_ROOT>/client-0.9.11/venv37/Scripts/python.exe
# CARLA_CLIENT_PATH=<CARLA_ROOT>/client-0.9.11/egg
CARLA_BRIDGE_TIMEOUT_SECONDS=600
# Optional spectator camera / real-time pacing for visible capture.
CARLA_FOLLOW_EGO=false
CARLA_REALTIME_CAPTURE=false
CHROMA_PERSIST_DIR=./data/chroma
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=false

# AI usage logging: fill key locally only if sending logs to the team dashboard.
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# Frontend has its own frontend/.env.local with API_INTERNAL_URL.
# deploy/.env is separate and used with docker compose --env-file.
