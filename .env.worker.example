# Copy to .env.worker on the GPU machine only. No LLM/database/S3 credentials here.
REMOTE_API_URL=https://p027-deploy.onrender.com
WORKER_ID=gpu-worker-01
WORKER_TOKEN=
WORKER_WORK_DIR=./data/remote-worker

# Must point at the full model directory, including CHECKPOINTS.sha256.
LAB_DATA_ROOT=./data/lab
EXPERIMENT_DEVICE=cpu
EXPERIMENT_CPU_THREADS=2
EXPERIMENT_EXECUTION_MODE=local
ANONYMIZER_ENABLED=false

CARLA_HOST=127.0.0.1
CARLA_PORT=2000
CARLA_TM_PORT=8001
CARLA_TIMEOUT_SECONDS=120
CARLA_BRIDGE_TIMEOUT_SECONDS=600
CARLA_MIN_AVAILABLE_MEMORY_GIB=10
# Ubuntu managed mode: set absolute path; worker launches CARLA only for a job.
# CARLA_SERVER_EXECUTABLE=/opt/carla/CarlaUE4/Binaries/Linux/CarlaUE4-Linux-Shipping
# Windows/external server: leave executable unset, launch server separately.
# Matching isolated client is optional (Python executable + optional CARLA SDK path).
# CARLA_PYTHON_EXECUTABLE=
# CARLA_CLIENT_PATH=
